generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  TERMINATED
}

enum AgencyApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  PENDING
  ONBOARDING
  TERMINATED
  ON_LEAVE
}

enum ApplicantStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  ONBOARDING
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
  EXPIRING_SOON
}

enum WorkflowStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum WorkPermitStatus {
  PENDING
  APPLIED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum VisaStatus {
  PENDING
  APPLIED
  APPOINTMENT_SCHEDULED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApplicantTier {
  LEAD
  CANDIDATE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  COMPLIANCE
  DOCUMENT_EXPIRY
  WORKFLOW
  SYSTEM
  FINANCIAL
  VEHICLE_MOT_EXPIRING
  VEHICLE_TAX_EXPIRING
  VEHICLE_INSURANCE_EXPIRING
  VEHICLE_REGISTRATION_EXPIRING
  VEHICLE_TACHOGRAPH_EXPIRING
  VEHICLE_ATP_EXPIRING
  VEHICLE_PRESSURE_TEST_DUE
  VEHICLE_SERVICE_DUE
  VEHICLE_SERVICE_OVERDUE
}

enum EntityType {
  EMPLOYEE
  APPLICANT
  APPLICATION
  AGENCY
  USER
  // Phase 2C (#32) — supporting documents for an attendance record
  // (e.g. doctor's note, medical certificate). entityId points at the
  // AttendanceRecord.id; the row inherits the usual Documents
  // permissions, storage, tenant scope, and metadata rules.
  ATTENDANCE
}

enum WorkflowCategory {
  INITIAL
  DOCUMENTATION
  COMPLIANCE
  TRAINING
  DEPLOYMENT
  ADMINISTRATIVE
}

model Role {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  isSystem       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  permissions        RolePermission[]
  users              User[]
  docTypePermissions DocumentTypePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  name      String   @unique
  module    String
  action    String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String     @id @default(uuid())
  userNumber     String?    @unique
  email          String     @unique
  passwordHash   String
  firstName      String
  middleName     String?
  lastName       String
  phone          String?
  dateOfBirth    DateTime?
  gender         Gender?
  citizenship    String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  country        String?
  postalCode     String?
  jobTitle       String?
  department     String?
  startDate      DateTime?
  photoUrl       String?
  roleId         String
  status         UserStatus @default(ACTIVE)
  agencyId       String
  lastLoginAt    DateTime?
  refreshToken   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?

  // Auth security fields
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
  passwordChangedAt   DateTime?
  passwordExpiresAt   DateTime?

  // Two-factor authentication (email OTP)
  twoFactorEnabled    Boolean              @default(false)
  twoFactorChallenges TwoFactorChallenge[]

  // Preferences
  preferredLanguage String? @default("en")
  timeZone          String? @default("UTC")
  notificationPrefs Json?

  // Self-referencing creator relation
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  role   Role   @relation(fields: [roleId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])

  notifications       Notification[]
  auditLogs           AuditLog[]
  uploadedDocuments   Document[]      @relation("UploadedDocuments")
  verifiedDocuments   Document[]      @relation("VerifiedDocuments")
  profileNotesCreated ProfileNote[]   @relation("ProfileNoteCreatedBy")
  profileNotesUpdated ProfileNote[]   @relation("ProfileNoteUpdatedBy")
  assignedStages      EmployeeStage[] @relation("AssignedStages")

  // Profile-creation attribution — populated when this user created an
  // applicant/employee from the dashboard. Public /apply submissions
  // leave createdById null on the record itself (source=SELF_APPLIED).
  createdApplicants Applicant[] @relation("ApplicantCreatedBy")
  createdEmployees  Employee[]  @relation("EmployeeCreatedBy")
  // §4.11 Notifications — APPLICANT_ASSIGNED_TO_ME requires an
  // explicit owner on Applicant. Back-relation lives here.
  ownedApplicants   Applicant[] @relation("ApplicantOwner")
  // §4.11 Notifications — EMPLOYEE_PROFILE_LOCKED needs the actor
  // who flipped the lock so audit + back-reference work.
  lockedEmployees   Employee[]  @relation("EmployeeProfileLockedBy")

  // ── Financial record relations ─────────────────────────────────────────
  financialRecordsPaidBy     FinancialRecord[]           @relation("FRPaidBy")
  financialRecordsCreated    FinancialRecord[]           @relation("FRCreatedBy")
  financialAttachments       FinancialRecordAttachment[] @relation("FRAttachmentUploadedBy")
  financialDeductionsCreated FinancialRecordDeduction[]  @relation("FRDeductionCreatedBy")

  resolvedAlerts  ComplianceAlert[] @relation("ResolvedAlerts")
  updatedSettings SystemSetting[]
  jobAdsCreated   JobAd[]           @relation("JobAdsCreated")

  // Phase 3 Reports Hardening (#17) — back-relation for Report.createdBy.
  reportsCreated Report[] @relation("ReportsCreated")

  // ── Workflow relations ─────────────────────────────────────────────────
  workflowsCreated            Workflow[]                      @relation("WorkflowsCreated")
  workflowStageUsers          WorkflowStageUser[]             @relation("WorkflowStageUsers")
  workflowAccess              WorkflowAccessUser[]            @relation("WorkflowAccess")
  workflowAssignments         CandidateWorkflowAssignment[]   @relation("WorkflowAssignments")
  employeeWorkflowAssignments EmployeeWorkflowAssignment[]    @relation("EmployeeWorkflowAssignments")
  stageApprovals              CandidateStageApproval[]        @relation("StageApprovals")
  employeeStageApprovals      EmployeeStageApproval[]         @relation("EmployeeStageApprovals")
  attendanceCreated           AttendanceRecord[]              @relation("AttendanceCreatedBy")
  attendanceUpdated           AttendanceRecord[]              @relation("AttendanceUpdatedBy")
  attendanceLockedPeriods     AttendanceLockedPeriod[]        @relation("AttendanceLockedBy")
  workHistoryCreated          EmployeeWorkHistory[]           @relation("WorkHistoryCreatedBy")
  workHistoryApproved         EmployeeWorkHistory[]           @relation("WorkHistoryApprovedBy")
  workHistoryAttachments      EmployeeWorkHistoryAttachment[] @relation("WorkHistoryAttachmentUploadedBy")
  stageNotes                  CandidateStageNote[]            @relation("StageNoteAuthors")

  // ── Vehicle relations ──────────────────────────────────────────────────
  vehiclesCreated     Vehicle[]           @relation("VehicleCreatedBy")
  vehiclesUpdated     Vehicle[]           @relation("VehicleUpdatedBy")
  vehicleDocsUploaded VehicleDocument[]   @relation("VehicleDocUploadedBy")
  maintenanceCreated  MaintenanceRecord[] @relation("MaintenanceCreatedBy")
  maintenanceUpdated  MaintenanceRecord[] @relation("MaintenanceUpdatedBy")
  systemBackups       SystemBackup[]      @relation("BackupCreatedBy")

  // Agency manager back-relation
  managedAgencies Agency[] @relation("AgencyManager")

  // Token relations
  activationTokens       ActivationToken[]
  passwordResetTokens    PasswordResetToken[]
  deleteRequests         CandidateDeleteRequest[] @relation("DeleteRequestedBy")
  reviewedDeleteRequests CandidateDeleteRequest[] @relation("DeleteRequestReviewedBy")
  permissionOverrides    AgencyUserPermission[]

  // Agency-tenancy approval workflow.
  // APPROVED = operational; PENDING_APPROVAL = created by an agency
  // manager and awaiting Tempworks sign-off; REJECTED = explicitly denied.
  // allowManagerEdit/Delete let Tempworks admins re-open an already
  // approved user so the owning agency manager can touch them again.
  approvalStatus     AgencyApprovalStatus @default(APPROVED)
  approvedById       String?
  approvedAt         DateTime?
  allowManagerView   Boolean              @default(true)
  allowManagerEdit   Boolean              @default(false)
  allowManagerDelete Boolean              @default(false)

  applicationDraft       ApplicationDraft?
  notificationPreference NotificationPreference? @relation("NotificationPreferences")

  @@map("users")
}

/// A save-for-later draft of an applicant creation form. Exactly one
/// open draft per user — enforced by the unique constraint on
/// `createdById`. No Lead/Applicant row is created until the draft
/// is submitted via POST /application-drafts/mine/submit, which
/// creates the applicant and deletes the draft atomically.
model ApplicationDraft {
  id          String   @id @default(uuid())
  createdById String   @unique
  jobAdId     String?
  /// Raw ApplicantFormData blob that drives the form on the client.
  formData    Json     @default("{}")
  /// Profile-photo URL (same /uploads/<folder>/... convention the rest
  /// of the app uses). Null until the user picks a photo.
  photoUrl    String?
  /// Supporting documents uploaded alongside the draft. Each entry:
  /// { id, name, typeName, url, uploadedAt }. On final submit these
  /// are materialised into Document rows linked to the new Applicant.
  documents   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([jobAdId])
  @@map("application_drafts")
}

model Agency {
  id                String       @id @default(uuid())
  name              String
  country           String
  contactPerson     String
  contactFirstName  String?
  contactMiddleName String?
  contactLastName   String?
  email             String
  phone             String
  whatsapp          String?
  website           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  stateRegion       String?
  postalCode        String?
  status            AgencyStatus @default(ACTIVE)
  logoUrl           String?
  notes             String?
  maxUsersPerAgency Int          @default(10)
  // Phase 3.9 — `isSystem` column dropped. Platform authority is now
  // sourced exclusively from `PlatformAdmin`. See
  // SAAS_PHASE3_DROP_AGENCY_IS_SYSTEM.md.
  managerId         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?

  // ── SaaS Phase 1 transitional columns (NULLABLE).
  //
  //  - `tenantId`: the customer Agency.id is reused as Tenant.id; for the
  //    DefaultAgency child created by the Phase 1 backfill, this points
  //    at the parent tenant. NULL for legacy rows pre-backfill and for
  //    any future agency that has not yet been associated with a tenant.
  //  - `isDefault`: true on the single Default Agency child created per
  //    tenant during backfill. Used to identify the "primary" agency
  //    inside a tenant.
  //  - `parentId`: hierarchical sub-agencies. Out of Phase 1 scope today;
  //    column reserved so a future migration can add the FK without an
  //    expand-contract dance.
  tenantId  String?
  isDefault Boolean @default(false)
  parentId  String?

  users                User[]
  employees            Employee[]
  applicants           Applicant[]
  vehicles             Vehicle[]
  manager              User?                      @relation("AgencyManager", fields: [managerId], references: [id])
  employeeAccessGrants EmployeeAgencyAccess[]
  permissionOverrides  AgencyPermissionOverride[]

  @@index([tenantId])
  @@map("agencies")
}

model Employee {
  id                   String         @id @default(uuid())
  employeeNumber       String?        @unique
  // ── Lifecycle traceability ────────────────────────────────────────────────
  // Copied from applicant at conversion time so prior-stage IDs survive
  // even after the applicant record is soft-deleted.
  leadNumber           String?
  candidateNumber      String?
  candidateConvertedAt DateTime?
  employeeConvertedAt  DateTime?
  // ── Core identity ─────────────────────────────────────────────────────────
  firstName            String
  lastName             String
  email                String         @unique
  phone                String
  nationality          String
  status               EmployeeStatus @default(PENDING)
  dateOfBirth          DateTime
  licenseNumber        String?
  licenseCategory      String?
  yearsExperience      Int            @default(0)
  jobTypeId            String?
  agencyId             String?
  photoUrl             String?
  addressLine1         String
  addressLine2         String?
  city                 String
  country              String
  postalCode           String
  emergencyContact     String?
  emergencyPhone       String?
  notes                String?
  // Full structured application data carried over from the applicant
  // at conversion time (same JSON blob the applicant form produces).
  // The Employee profile uses this to render every captured field
  // without rehydrating the applicant — see ApplicationDataView.
  applicationData      Json?
  // Creation attribution — carried over from the Applicant at
  // conversion time. See Applicant.createdById/source for semantics.
  createdById          String?
  source               String         @default("STAFF_CREATED")

  // §4.11 Notifications — contract lifecycle. contractEndDate drives
  // the EMPLOYEE_CONTRACT_EXPIRING tiered cron + the
  // EMPLOYEE_CONTRACT_ENDED emit; contractStartDate is captured so a
  // RENEWED transition (end moving forward) can be distinguished
  // from a brand-new contract. NULL means "no fixed-term contract on
  // file" — open-ended employments stay silent.
  contractStartDate    DateTime?
  contractEndDate      DateTime?

  // §4.11 Notifications — EMPLOYEE_PROFILE_LOCKED. Admins lock a
  // profile to prevent self-edits; both the affected employee and HR
  // hear the toggle. Columns are nullable so existing rows don't
  // need a backfill.
  profileLocked        Boolean        @default(false)
  profileLockedAt      DateTime?
  profileLockedBy      String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  deletedBy            String?
  deletionReason       String?

  agency              Agency?                      @relation(fields: [agencyId], references: [id])
  jobType             JobType?                     @relation(fields: [jobTypeId], references: [id])
  createdBy           User?                        @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  profileLockActor    User?                        @relation("EmployeeProfileLockedBy", fields: [profileLockedBy], references: [id])
  employeeStages      EmployeeStage[]
  workPermits         WorkPermit[]
  workflowAssignments EmployeeWorkflowAssignment[]
  stageApprovals      EmployeeStageApproval[]
  attendanceRecords   AttendanceRecord[]           @relation("EmployeeAttendance")
  vehicleAssignments  VehicleDriverAssignment[]
  agencyAccessGrants  EmployeeAgencyAccess[]
  workHistory         EmployeeWorkHistory[]
  employmentContracts EmploymentContract[]         @relation("EmployeeContracts")

  // SaaS Phase 1 transitional column. Populated by the tenant backfill
  // (one update per row, derived from `agencyId` → tenant). NULL today
  // and through Phase 1; promoted to NOT NULL in Phase 2.
  tenantId String?

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("employees")
}

// ── Employment Contracts ──────────────────────────────────────────────────────
//
// A first-class contract record for an employee, with an effective
// start date and an optional end date (NULL = open-ended). Multiple
// rows per employee chain into a chronological employment timeline
// (initial contract → renewal → …). Distinct from EmployeeWorkHistory,
// which records discrete post-hire *events* (probation, termination).
//
// `documentId` links the contract to the uploaded "Employment/Work
// Contract" Document it was derived from; `source` records whether the
// row was entered manually or auto-created from a document upload so
// the two paths never fight over the same record.
model EmploymentContract {
  id           String    @id @default(uuid())
  employeeId   String
  startDate    DateTime
  /// NULL = open-ended employment (no fixed end).
  endDate      DateTime?
  contractType String    @default("Full-time")
  /// UPCOMING (start in future) | ACTIVE | ENDED (past end date).
  /// Stored for filtering; also derivable from the dates.
  status       String    @default("ACTIVE")
  /// The source/attached contract Document, when derived from an upload.
  documentId   String?
  notes        String?
  /// MANUAL | DOCUMENT — provenance of the row.
  source       String    @default("MANUAL")
  tenantId     String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  employee Employee  @relation("EmployeeContracts", fields: [employeeId], references: [id])
  document Document? @relation("ContractDocument", fields: [documentId], references: [id])

  @@index([employeeId])
  @@index([tenantId])
  @@index([documentId])
  @@map("employment_contracts")
}

model StageTemplate {
  id                    String           @id @default(uuid())
  name                  String           @unique
  order                 Int
  description           String?
  color                 String           @default("#2563EB")
  category              WorkflowCategory @default(INITIAL)
  isActive              Boolean          @default(true)
  requirementsDocuments String[]         @default([])
  requirementsActions   String[]         @default([])
  requirementsApprovals String[]         @default([])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  employeeStages    EmployeeStage[]
  applicantsCurrent Applicant[]     @relation("ApplicantCurrentStage")

  @@map("stage_templates")
}

model EmployeeStage {
  id           String              @id @default(uuid())
  employeeId   String
  stageId      String
  status       WorkflowStageStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  assignedToId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stage      StageTemplate @relation(fields: [stageId], references: [id])
  assignedTo User?         @relation("AssignedStages", fields: [assignedToId], references: [id])

  @@unique([employeeId, stageId])
  @@map("employee_stages")
}

model JobType {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String?
  requiredDocuments String[]  @default([])
  isActive          Boolean   @default(true)
  /// Per-locale overrides. Shape: { "ar": { "name": "…", "description": "…" }, "de": { … }, … }.
  /// Reads should fall back to `name`/`description` when the active locale has no entry.
  translations      Json?
  // Phase 3.16 — soft-delete columns so the Job Categories settings page
  // can distinguish "Deactivate" (isActive=false) from "Delete" (deletedAt
  // set). Deleted rows surface in the recycle bin like every other entity.
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  applicants Applicant[]
  employees  Employee[]

  @@index([deletedAt])
  @@map("job_types")
}

// Configurable labels for the `transactionType` column on
// FinancialRecord. Previously hardcoded in backend/src/finance/
// constants.ts; now stored in the DB so System Admins can add /
// rename / deactivate types without a code deploy. The values on
// existing financial_records stay free-text strings, so deactivating a
// type never breaks historical rows.
model FinanceTransactionType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  // Preserve the order System Admins want rendered in the dropdown —
  // lower = earlier. Ties fall back to alphabetical.
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("finance_transaction_types")
}

model Applicant {
  id                      String          @id @default(uuid())
  tier                    ApplicantTier   @default(LEAD)
  // ── Core identity ─────────────────────────────────────────────────────────
  firstName               String
  middleName              String?
  lastName                String
  email                   String
  phone                   String
  // citizenship replaces nationality (nationality kept for backward compat)
  nationality             String?
  citizenship             String?
  gender                  Gender?
  dateOfBirth             DateTime?
  countryOfBirth          String?
  cityOfBirth             String?
  photoUrl                String?
  hasDrivingLicense       Boolean         @default(false)
  // ── Status & assignment ───────────────────────────────────────────────────
  status                  ApplicantStatus @default(NEW)
  jobTypeId               String?
  agencyId                String?
  // ── Legacy flat fields (kept for backward compat) ─────────────────────────
  residencyStatus         String?
  hasNationalInsurance    Boolean         @default(false)
  nationalInsuranceNumber String?
  hasWorkAuthorization    Boolean         @default(false)
  workAuthorizationType   String?
  workAuthorizationExpiry DateTime?
  preferredStartDate      DateTime?
  availability            String?
  willingToRelocate       Boolean         @default(false)
  preferredLocations      String?
  salaryExpectation       String?
  notes                   String?
  // ── Lifecycle identifiers ─────────────────────────────────────────────────
  // leadNumber:       assigned at creation          (A + YYYY + MM + 5-digit serial)
  // candidateNumber:  assigned at Lead→Candidate    (C + YYYY + MM + 5-digit serial)
  // employeeConvertedAt: timestamp of Candidate→Employee conversion
  // Serial resets monthly per prefix; generated via identifier_sequences table
  leadNumber              String?
  candidateNumber         String?
  candidateConvertedAt    DateTime?
  employeeConvertedAt     DateTime?
  // ── Rich structured application data (JSON) ───────────────────────────────
  // Stores: addresses, passport, ID, visa, residence, work permit, criminal records,
  // driving license details, driving experience, education[], workHistory[],
  // skills, emergency contact, additional info, declaration
  applicationData         Json?
  convertedToEmployeeId   String?
  // ── Creation attribution ──────────────────────────────────────────────────
  // createdById: null when the applicant filled the public /apply form
  //              themselves; otherwise the System/HR/Recruiter/Agency user
  //              who created the record from the dashboard.
  // source:      "SELF_APPLIED" for public submissions, "STAFF_CREATED"
  //              (default) for every dashboard-originated create. Carried
  //              forward verbatim to the Employee row on conversion.
  createdById             String?
  source                  String          @default("STAFF_CREATED")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?
  deletedBy               String?
  deletionReason          String?

  currentWorkflowStageId String?

  // ── Job Ad linkage ────────────────────────────────────────────────────────
  jobAdId String?
  jobAd   JobAd?  @relation(fields: [jobAdId], references: [id])

  jobType              JobType?                      @relation(fields: [jobTypeId], references: [id])
  agency               Agency?                       @relation(fields: [agencyId], references: [id])
  currentWorkflowStage StageTemplate?                @relation("ApplicantCurrentStage", fields: [currentWorkflowStageId], references: [id])
  createdBy            User?                         @relation("ApplicantCreatedBy", fields: [createdById], references: [id])

  // §4.11 Notifications — APPLICANT_ASSIGNED_TO_ME. The owning
  // recruiter is captured here; NULL means "unassigned" and the
  // public + agency-submit paths leave it that way.
  ownerUserId          String?
  owner                User?                         @relation("ApplicantOwner", fields: [ownerUserId], references: [id])

  financialProfile     ApplicantFinancialProfile?
  agencyHistory        ApplicantAgencyHistory[]
  workflowAssignments  CandidateWorkflowAssignment[]
  deleteRequests       CandidateDeleteRequest[]

  // Tempworks-approval gate for agency-submitted candidates. Defaults to
  // APPROVED for internal-created applicants so existing data stays live.
  approvalStatus  AgencyApprovalStatus @default(APPROVED)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  // SaaS Phase 1 transitional column. NULL until backfill; NOT NULL in Phase 2.
  tenantId String?

  @@index([tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("applicants")
}

model ApplicantFinancialProfile {
  id            String   @id @default(uuid())
  applicantId   String   @unique
  employeeId    String?  @unique // set when applicant is converted to employee; enables lookup from employee profile
  bankName      String?
  accountHolder String?
  accountNumber String?
  sortCode      String?
  iban          String?
  bankAddress   String?
  taxCode       String?
  niNumber      String?
  paymentMethod String?
  salaryAgreed  Decimal? @db.Decimal(10, 2)
  currency      String   @default("GBP")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("applicant_financial_profiles")
}

model ApplicantAgencyHistory {
  id           String    @id @default(uuid())
  applicantId  String
  agencyId     String?
  agencyName   String
  assignedAt   DateTime  @default(now())
  removedAt    DateTime?
  assignedById String?
  reason       String?
  notes        String?

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@map("applicant_agency_history")
}

model DocumentType {
  id                String    @id @default(uuid())
  name              String    @unique
  /// Short uppercase code used in business document IDs, e.g. PASS, VISA, TRC.
  /// Generated from the first 4 chars of name if not set explicitly.
  code              String?
  description       String?
  category          String
  required          Boolean   @default(false)
  trackExpiry       Boolean   @default(true)
  renewalPeriodDays Int?
  isActive          Boolean   @default(true)
  /// Per-locale overrides. Shape: { "ar": { "name": "…", "description": "…" }, "de": { … }, … }.
  translations      Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?

  documents         Document[]
  permissions       DocumentTypePermission[]
  workflowStageReqs WorkflowStageRequiredDoc[]

  @@map("document_types")
}

model Document {
  id              String         @id @default(uuid())
  /// Business document ID: DOC{PersonNumber}{TypeCode}{3-digit sequence}
  /// E.g. DOCC20260400001PASS001 — unique per non-null value.
  docId           String?        @unique
  name            String
  documentTypeId  String
  entityType      EntityType
  entityId        String
  fileUrl         String
  mimeType        String
  fileSize        Int
  status          DocumentStatus @default(PENDING)
  issueDate       DateTime?
  expiryDate      DateTime?
  issueCountry    String?
  issuer          String?
  documentNumber  String?
  notes           String?
  /// Populated when status = REJECTED; stored separately from notes.
  rejectionReason String?
  uploadedById    String
  verifiedById    String?
  verifiedAt      DateTime?
  /// Self-reference: points to the document this one renews/supersedes.
  renewedFromId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  deletionReason  String?
  /// Manual archive ("No longer valid"). Archived documents stay stored
  /// and visible in history but drop out of the active/highlighted set
  /// (lists default to active, compliance counts, expiry reminders, and
  /// the daily digest all exclude archived). NOT automatic — an operator
  /// archives an old document once its replacement is on file.
  archivedAt      DateTime?
  archivedBy      String?

  documentType     DocumentType      @relation(fields: [documentTypeId], references: [id])
  uploadedBy       User              @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  verifiedBy       User?             @relation("VerifiedDocuments", fields: [verifiedById], references: [id])
  complianceAlerts ComplianceAlert[]
  renewedFrom      Document?         @relation("DocumentRenewal", fields: [renewedFromId], references: [id])
  renewals         Document[]        @relation("DocumentRenewal")
  employmentContracts EmploymentContract[]         @relation("ContractDocument")
  // Phase 2.3 entity-keyed denorm. NULL until backfill; remains nullable
  // through Phase 2; promoted to NOT NULL no earlier than Phase 3.
  tenantId         String?

  @@index([entityType, entityId])
  @@index([status])
  @@index([documentTypeId])
  @@index([expiryDate])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("documents")
}

/// Fine-grained per-document-type permissions per role.
/// A missing row means the role uses its general documents:* permission.
model DocumentTypePermission {
  id             String   @id @default(uuid())
  documentTypeId String
  roleId         String
  canUpload      Boolean  @default(true)
  canView        Boolean  @default(true)
  canEdit        Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canRenew       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([documentTypeId, roleId])
  @@map("document_type_permissions")
}

model WorkPermit {
  id               String           @id @default(uuid())
  employeeId       String
  permitType       String
  status           WorkPermitStatus @default(PENDING)
  permitNumber     String?
  applicationDate  DateTime
  approvalDate     DateTime?
  expiryDate       DateTime
  issuingAuthority String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Phase 2.3 entity-keyed denorm.
  tenantId String?

  @@index([tenantId])
  @@map("work_permits")
}

model Visa {
  id              String     @id @default(uuid())
  entityType      EntityType
  entityId        String
  visaType        String
  status          VisaStatus @default(PENDING)
  visaNumber      String?
  applicationDate DateTime
  appointmentDate DateTime?
  approvalDate    DateTime?
  expiryDate      DateTime?
  embassy         String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Phase 2.3 entity-keyed denorm.
  tenantId String?

  @@index([tenantId])
  @@map("visas")
}

model Notification {
  id              String           @id @default(uuid())
  userId          String
  // Pre-rendered English title/message. Always populated for backward
  // compatibility — old clients keep working, search/grep over historical
  // notifications keeps reading meaningful text.
  title           String
  message         String
  // i18n metadata. Set by Phase 3.F+ producers; null on legacy rows.
  // The reader prefers translated `<group>.<KEY>` lookup against the
  // server's notifications catalog (`tServer`) using the requester's
  // `Accept-Language`, falling back to `title` / `message` when the keys
  // aren't set or the locale catalog has no matching entry.
  titleKey        String?
  messageKey      String?
  params          Json?
  type            NotificationType @default(INFO)
  // Specific event type string (e.g. DOCUMENT_UPLOADED, FINANCIAL_RECORD_CREATED)
  eventType       String?
  // Delivery channel: in_app | email
  channel         String           @default("in_app")
  isRead          Boolean          @default(false)
  readAt          DateTime?
  relatedEntity   String?
  relatedEntityId String?
  // For vehicle notifications: days/km until due
  daysUntilDue    Int?
  kmUntilDue      Int?
  // For vehicle notifications: severity (LOW/MEDIUM/HIGH)
  severity        String?
  // §4.11.4 priority — sort/filter rank. Stored as INT for natural
  // numeric order (1=URGENT, 2=HIGH, 3=NORMAL default, 4=LOW). The
  // service translates between this rank and the display name at the
  // API boundary. Column added by prisma.service.healAdditiveDrift on
  // pre-existing deployments; new deployments materialise it via
  // this schema entry on first `prisma generate`.
  priority        Int              @default(3)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  deletedBy       String?
  deletionReason  String?

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Phase 2.3 entity-keyed denorm.
  tenantId String?

  @@index([userId, isRead])
  @@index([userId, eventType])
  @@index([userId, type])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("notifications")
}

model AuditLog {
  id             String    @id @default(uuid())
  userId         String?
  userEmail      String?
  action         String
  entity         String
  entityId       String
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  deletedBy      String?
  deletionReason String?
  tenantId       String?

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ComplianceAlert {
  id           String        @id @default(uuid())
  entityType   EntityType
  entityId     String
  documentId   String?
  alertType    String
  severity     AlertSeverity @default(MEDIUM)
  message      String
  status       AlertStatus   @default(OPEN)
  dueDate      DateTime?
  resolvedAt   DateTime?
  resolvedById String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  document   Document? @relation(fields: [documentId], references: [id])
  resolvedBy User?     @relation("ResolvedAlerts", fields: [resolvedById], references: [id])

  // Phase 2.3 entity-keyed denorm.
  tenantId String?

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("compliance_alerts")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model NotificationRule {
  id               String    @id @default(uuid())
  name             String
  trigger          String
  entityType       String
  daysBeforeExpiry Int?
  channels         String[]
  recipientRoles   String[]
  isActive         Boolean   @default(true)
