 backend/src/documents/documents.controller.ts |  4 +-
 backend/src/documents/documents.service.ts    | 41 +++++++++++++++----
 2 files changed, 34 insertions(+), 11 deletions(-)

diff --git a/backend/src/documents/documents.controller.ts b/backend/src/documents/documents.controller.ts
index 1e566b5..1f784cf 100644
--- a/backend/src/documents/documents.controller.ts
+++ b/backend/src/documents/documents.controller.ts
@@ -115,9 +115,9 @@ export class DocumentsController {
   @RequirePermission('documents:create')
   @HttpCode(HttpStatus.OK)
   @ApiOperation({ summary: 'Download multiple documents as a structured ZIP archive' })
-  async bulkDownload(@Body() dto: { ids: string[] }, @Res() res: Response) {
+  async bulkDownload(@Body() dto: { ids: string[] }, @Res() res: Response, @CurrentUser() user: any) {
     if (!dto.ids?.length) { res.status(400).json({ message: 'No document IDs provided' }); return; }
-    const buffer = await this.documentsService.createBulkDownloadArchive(dto.ids);
+    const buffer = await this.documentsService.createBulkDownloadArchive(dto.ids, user);
     res.setHeader('Content-Type', 'application/zip');
     res.setHeader('Content-Disposition', `attachment; filename="documents_${Date.now()}.zip"`);
     res.setHeader('Content-Length', buffer.length);
diff --git a/backend/src/documents/documents.service.ts b/backend/src/documents/documents.service.ts
