# Database
# Supported libpq sslmode values (see backend/prisma/pg-ssl.ts):
#   disable      — no SSL (typical for local dev Postgres)
#   allow        — no SSL (libpq's "try plain, then SSL" fallback is not
#                  supported by node-pg; treated as disable)
#   prefer       — SSL without certificate verification
#   require      — SSL without certificate verification (common for managed
#                  cloud databases that issue self-signed certs)
#   verify-ca    — SSL with CA chain verification, hostname check skipped
#   verify-full  — SSL with full CA + hostname verification (strictest)
#
# When `sslmode` is omitted, SSL is disabled. Set it explicitly on managed
# or production databases that require TLS. The mode is also forwarded to
# pg_dump / pg_restore via PGSSLMODE so backups work against SSL-only hosts.
DATABASE_URL="postgresql://postgres:password@localhost:5432/tempworks_db?sslmode=disable"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# File Upload
# UPLOAD_STORAGE_DRIVER selects where new uploads are stored:
#   local  — write to UPLOAD_DEST on disk (development default; not for production)
#   spaces — push to DigitalOcean Spaces using the DO_SPACES_* vars below
UPLOAD_STORAGE_DRIVER=local
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# DigitalOcean Spaces (S3-compatible) — required when UPLOAD_STORAGE_DRIVER=spaces
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=tempworks-uploads
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_PUBLIC_URL=https://tempworks-uploads.fra1.digitaloceanspaces.com

# Admin Seed
SEED_ADMIN_EMAIL=admin@tempworks.com
SEED_ADMIN_PASSWORD=Admin@123456

# ─── Backup & Disaster Recovery ───────────────────────────────────────────────
# Where backup packages are written. MUST be a PERSISTENT volume in production
# (NOT ephemeral container storage) or backups vanish on redeploy. See
# docs/DISASTER_RECOVERY_RUNBOOK.md.
BACKUP_DIR=/var/lib/tempworks/backups

# Optional explicit path to the PostgreSQL client tools. Leave unset to let the
# app auto-detect the newest installed client whose major version >= the DB
# server (fixes the pg_dump 17.x vs server 18.x mismatch). Install the client
# with deploy/provision-postgres-client-18.sh.
# PG_BIN_PATH=/usr/lib/postgresql/18/bin

# Keep at most this many COMPLETED backups on local disk (the newest and the
# newest VERIFIED backup are always preserved regardless of this count).
BACKUP_RETENTION_COUNT=10

# Off-server copy of backup packages (independent of the app's uploads bucket).
# When set, each backup is uploaded here so a lost server does not lose the
# only copy. Falls back to DO_SPACES_* credentials/endpoint if the BACKUP_*
# ones are omitted. Use a SEPARATE, PRIVATE bucket (never public-read).
BACKUP_SPACES_ENDPOINT=
BACKUP_SPACES_REGION=
BACKUP_SPACES_BUCKET=
BACKUP_SPACES_ACCESS_KEY=
BACKUP_SPACES_SECRET_KEY=
BACKUP_SPACES_PREFIX=dr/

# Scheduled backups. UNSET = scheduling DISABLED (the admin UI says so).
# Example (operator decision): BACKUP_SCHEDULE_CRON="17 2 * * *"
# BACKUP_SCHEDULE_CRON=
# BACKUP_SCHEDULE_TZ=Europe/Bratislava     # default UTC
# BACKUP_SCHEDULE_KIND=FULL_SYSTEM         # or DATABASE
# BACKUP_STALE_HOURS=26                    # alert when no verified backup is newer
# BACKUP_CONSISTENCY_RETRIES=2             # capture retries when files change mid-backup

# Deferred object deletion (keeps DB+file backups consistent): deletes are queued
# and purged later — never during a backup, never while still referenced.
# STORAGE_PURGE_GRACE_HOURS=24
# STORAGE_DEFERRED_DELETE=off               # opt-out: delete immediately (not recommended)

# Only for MinIO / other S3-compatible endpoints that need path-style URLs.
# Leave unset for DigitalOcean Spaces.
# DO_SPACES_FORCE_PATH_STYLE=1
# BACKUP_SPACES_FORCE_PATH_STYLE=1
